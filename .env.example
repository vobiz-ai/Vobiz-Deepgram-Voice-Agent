# Copy to .env and fill in. The app loads this on startup.

# --- Required ---

# Deepgram runs the whole Voice Agent: speech-to-text, the LLM, and text-to-speech.
DEEPGRAM_API_KEY=

# The public host Vobiz can reach, no scheme. Used to build the wss:// stream URL and the
# statusCallbackUrl in the answer XML.
PUBLIC_HOSTNAME=your-host.example.com

# --- Optional ---

HTTP_PORT=5050

# Audio profile. Both directions are passthrough — no resampling happens in this app.
#   mulaw  Vobiz -> app  audio/x-mulaw;rate=8000   |  app -> Vobiz  mulaw 8000   (default)
#   l16    Vobiz -> app  audio/x-l16;rate=16000    |  app -> Vobiz  L16 24000
AUDIO_MODE=mulaw

# --- Security (optional for a first local run, recommended for anything shared) ---

# A random string used to authenticate the /media WebSocket. It becomes a path segment on the
# stream URL, so it must be alphanumeric:
#   python -c "import secrets; print(secrets.token_hex(16))"
# If unset, /media connections are not authenticated.
STREAM_SECRET=

# Set to true to validate the X-Vobiz-Signature-V3 (or V2) HMAC on /answer, keyed by
# VOBIZ_AUTH_TOKEN. Vobiz only sends signature headers when the callback URL has auth
# credentials configured on it — set those in the console first, then enable this.
VERIFY_SIGNATURE=

# --- Outbound calls (only needed by call.py) ---
# Inbound works without these — just point the number's answer URL at /answer.

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=+91XXXXXXXXXX
TO_NUMBER=+91XXXXXXXXXX
