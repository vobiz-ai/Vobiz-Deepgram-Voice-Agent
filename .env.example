# Copy to .env and fill in. The app loads this on startup.
# Only the two values in the first section are required.

# --- Required ---

# Deepgram runs the whole Voice Agent: speech-to-text, the LLM, and text-to-speech.
DEEPGRAM_API_KEY=

# The public host Vobiz can reach. A bare hostname -- any scheme or trailing slash is
# stripped, and a path is rejected. Start a tunnel and paste its host here:
#   cloudflared tunnel --url http://127.0.0.1:5050
#   ngrok http 127.0.0.1:5050
# e.g. PUBLIC_HOSTNAME=abc123.ngrok-free.app
PUBLIC_HOSTNAME=

# --- Region ---

# india  -> api.in.deepgram.com (AWS ap-south-2, Hyderabad). Default.
#           Measured from Bengaluru, first audio arrives in ~0.4s against India
#           versus ~1.5s against the global endpoint.
# global -> Deepgram's default hosts.
# Note the LLM step runs wherever that model provider runs, which is outside India,
# and operational metadata and billing are processed in the US.
DEEPGRAM_REGION=india

# --- Language and voice ---

# en-in  English conversation, Indian-accented voice. Default, and the fastest.
# hi-in  understands Hindi and English including mid-sentence code-switching,
#        still answers in English.
# indic  one Indic language via nova-3 (set INDIC_LANGUAGE). Slower: nova is a v1
#        provider, so it forgoes Flux end-of-turn detection entirely.
# en-us  American voice, for non-India deployments or an A/B.
#
# Every locale replies in ENGLISH. Deepgram has no Hindi or Indic voice -- all Flux
# voices are English models, and giving one romanised Hindi makes it slow and
# garbled. The Indian character comes from the voice, not the words.
AGENT_LOCALE=en-in

# Only used when AGENT_LOCALE=indic: ta te mr bn gu pa kn as ur
INDIC_LANGUAGE=ta

# Override the locale's voice. The Indian-accented ones are:
#   flux-meena-en   female -- customer service, casual chat  (default)
#   flux-priya-en   female -- IVR, confident and reassuring
#   flux-naveen-en  male   -- IVR, support, informative
DG_TTS_MODEL=

# Override the first thing the caller hears.
GREETING=

# --- Language model ---

# The LLM is where the latency lives: recognition is a few hundred ms and synthesis
# under 100 ms, so this is the setting worth benchmarking. Median time from a user
# message to first audio, India endpoint, six turns each:
#
#   anthropic  claude-haiku-4-5        945 ms   (822-962)   <- default
#   open_ai    gpt-4.1-mini           1347 ms  (1202-1790)
#   google     gemini-3.1-flash-lite  1387 ms  (1196-1465)
#   open_ai    gpt-4o-mini            1444 ms  (1115-1755)
#   google     gemini-2.5-flash       1807 ms
#   google     gemini-3.5-flash       2700 ms
#   open_ai    gpt-5-mini             4792 ms
#
# All are Deepgram-managed, so no provider API key is needed here.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# --- Turn-taking (Flux only; the indic locale uses nova, which ignores these) ---

# Confidence needed to end a turn, 0.5-1.0. Raise it on a noisy line so background
# speech is less likely to be read as the caller taking a turn.
EOT_THRESHOLD=0.7

# End the turn this long after speech regardless of confidence. Deepgram's default
# is 5000, which is a long silence on a phone call.
EOT_TIMEOUT_MS=3000

# Start generating the reply on a medium-confidence turn end, before the turn is
# confirmed, and discard the work if the caller was mid-sentence. 0.3-0.9, or 0 to
# disable. Deepgram's own low-latency profile uses 0.4.
EAGER_EOT_THRESHOLD=0.4

# --- Transport ---

HTTP_PORT=5050

# Bind address. Loopback assumes a tunnel in front of this.
BIND_HOST=127.0.0.1

# Set to anything to enable uvicorn's auto-reloader. Off by default: a reload drops
# every call in progress.
DEV_RELOAD=

# Audio profile. Both directions are passthrough -- no resampling happens here.
#   mulaw  Vobiz -> app  audio/x-mulaw;rate=8000   |  app -> Vobiz  mulaw 8000   (default)
#   l16    Vobiz -> app  audio/x-l16;rate=16000    |  app -> Vobiz  L16 24000
AUDIO_MODE=mulaw

# --- Security (optional for a first local run, recommended for anything shared) ---

# Authenticates the /media WebSocket. It becomes a path segment on the stream URL and
# is compared byte-wise at the handshake, so it must be ASCII alphanumeric:
#   python -c "import secrets; print(secrets.token_hex(16))"
# If unset, /media connections are not authenticated.
STREAM_SECRET=

# Set to true to validate the X-Vobiz-Signature-V3 (or V2) HMAC on every webhook,
# keyed by VOBIZ_AUTH_TOKEN. Vobiz only sends signature headers when the callback URL
# has auth credentials configured on it -- set those in the console first, then enable
# this, or every genuine request will be rejected.
VERIFY_SIGNATURE=

# --- Outbound calls (only needed by call.py) ---
# Inbound works without these -- just point the number's answer URL at /answer.

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=+91XXXXXXXXXX
TO_NUMBER=+91XXXXXXXXXX
